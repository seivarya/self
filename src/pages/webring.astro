---
import Home from "../layouts/home.astro";

interface site {
	name: string;
	url: string;
}

async function fetch_members(): Promise<site[]> {
	try {
		const response = await fetch("https://ring.seggs.lol/webring");
		const obj = await response.json();
		return obj;
	} catch (e) {
		console.error(
			"Failed to fetch webring members at build time:",
			e,
		);
		return [];
	}
}

const sites = await fetch_members();
---

<script src="../scripts/webring.ts"></script>

<Home>
	<div class="main-container">
		<div>
			<h1 class="page-title">webring</h1>
			<p class="page-subtitle">
				cool ppl i know! checkout their stuff asw.
			</p>
		</div>

		<div class="webring-container">
			<web-ring>
				{
					sites.map((site) => (
						<a
							class="webring-site"
							href={site.url}
						>
							{site.name.toLowerCase()}
						</a>
					))
				}
			</web-ring>
		</div>
	</div>
</Home>

<style>
	.main-container {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.page-subtitle {
		font-size: 1.05rem;
		color: var(--color-text-muted);
		margin-top: -15px;
		margin-bottom: 40px;
	}

	.webring-container {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2rem 1.5rem;
		align-items: center;
		justify-content: center;
		width: 100%;
	}

	web-ring {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2rem 1.5rem;
		align-items: center;
		justify-content: center;
		width: 100%;
	}

	.webring-title {
		display: inline-block;
		font-weight: 100;
		text-decoration: none;
	}

	.webring-site {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35em 0.8em;
		font-family: inherit;
		font-weight: inherit;
		text-decoration: none;
		color: var(--color-text-muted);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 0px;
		box-shadow: 0 3px 0 var(--color-text-italic);
		transition:
			transform 0.1s ease,
			box-shadow 0.1s ease,
			background 0.1s ease,
			color 0.1s ease;
		white-space: nowrap;
	}

	.webring-site:hover {
		color: var(--color-text-main);
		transform: translateY(3px);
		box-shadow: 0 0 0 var(--color-text-italic);
	}

	.webring-site:active {
		transform: translateY(3px);
		box-shadow: 0 0 0 var(--color-text-italic);
	}

	@media (max-width: 600px) {
		.main-container {
			gap: 1px;
		}
		.webring-title {
			font-size: 0.9rem;
		}
		.webring-container {
			justify-content: center;
			gap: 1rem 1rem;
		}
	}
</style>
