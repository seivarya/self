---
import Home from "../layouts/home.astro";
import Cleanindex from "../components/ui/cleanindex.astro";
import { getCollection } from "astro:content";

function compareFn(obj1: any, obj2: any) {
	if (obj1.data.date < obj2.data.date) {
		return 1;
	} else if (obj1.data.date > obj2.data.date) {
		return -1;
	} else {
		return 0;
	}
}

const objects = await getCollection("notes");
const posts = objects.sort(compareFn);
---

<Home>
	<h1>notes</h1>
	<p class="page-subtitle">technical learnings, blogs, tutorials and deep dives.</p>

	<div class="list-container">
		{posts.map((post) => <Cleanindex title={post.data.title} date={post.data.date} slug={post.id} collection="notes" />)}
	</div>
</Home>

<style>
	.list-container {
		display: flex;
		flex-direction: column;
		width: 100%;
	}
</style>
