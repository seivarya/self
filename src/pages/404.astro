---
import "../styles/global.css";
import "@fontsource/source-code-pro";
import ThemeScript from "../components/theme.astro";
---

<!doctype html>
<html>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>404 - Not Found</title>
		<meta name="theme-color" content="#0f0e1a" />
		<ThemeScript />
	</head>
	<body>
		<div class="error-container">
			<img src="/404.webp" alt="404" class="error-img" />
			<a href="/" class="home-link">go back home</a>
		</div>
	</body>
</html>

<style>
	.error-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		min-height: 100vh;
		gap: 20px;
		background-color: var(--color-bg);
	}

	.error-img {
		max-width: 90vw;
		max-height: 70vh;
		border-radius: 8px;
	}

	.home-link {
		color: var(--color-text-muted);
		text-decoration: underline;
		text-decoration-color: var(--color-border);
		text-underline-offset: 4px;
		font-family: inherit;
		transition:
			color 0.2s,
		text-decoration-color 0.2s;
	}

	.home-link:hover {
		color: var(--color-text-hover);
		text-decoration-color: var(--color-text-hover);
	}
</style>
