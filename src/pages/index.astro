---
import Home from "../layouts/home.astro";
import Socials from "../components/socials.astro";
---

<Home>
	<section class="about-section">
		<div class="intro-section">
			<div class="intro-w-resume">
				<p>hey, i'm shivang.</p>
				<p>here's my resume:</p>
				<div class="resume-icon">
					<a href="/resume.pdf">
						<svg class="resume-svg" viewBox="0 0 24 24" display="inline-block" fill="none" xmlns="http://www.w3.org/2000/svg">
							<rect width="24" height="24" rx="6" fill="none" />
							<g transform="translate(0,-0.8)">
								<path d="M7 20C5.89543 20 5 19.1046 5 18V3H14L19 8V18C19 19.1046 18.1046 20 17 20H7Z" stroke="var(--color-text-muted)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
								<path d="M13 3V9H19" stroke="var(--color-text-muted)" stroke-width="1.3" stroke-linejoin="round" />
								<path d="M9 13H15" stroke="var(--color-text-muted)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
								<path d="M9 16.5H15" stroke="var(--color-text-muted)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
							</g>
						</svg>
					</a>
				</div>
			</div>
			<p>
				i'm a cs undergrad trying to get better at
				backend and low-level programming. basically,
				figuring out how things work under the hood
				while still building stuff people can actually
				use.
			</p>
		</div>

		<div class="socials-row">
			<span class="socials-label">here are my socials:</span>
			<Socials />
		</div>

		<div class="intro-section">
			<p>
				lately i've been spending more time
				understanding systems, memory, performance,
				tooling.
			</p>
			<p>
				i also write <a class="blog-link" href="/notes">technical blogs</a>
				whenever i build something or stumble onto something worth sharing.
			</p>
			<p>i mainly work with:</p>
		</div>

		<div class="contact-section">
			<p>
				if you want to collaborate, discuss ideas, or
				just point out something i got wrong, feel free
				to reach out:
				<a class="email-link" href="mailto:hey@seivarya.in">hey@seivarya.in</a>
			</p>
			<p>
				outside of programming, i'm probably playing
				games, reading random blogs/books, or watching
				something. i have a bunch of social links around
				here somewhere, but i'm not active on most of
				them. if you want a quick reply, <a class="discord-link" href="https://discord.com/users/1345276369566699530">discord</a>
				is your best bet.
			</p>
		</div>
	</section>
</Home>

<style>
	.contact-section {
		margin-bottom: 20px;
	}

	@media (max-width: 600px) {
		.contact-section {
			margin-bottom: 10px;
		}

		.resume-icon {
			width: 16px;
			height: 16px;
			padding-top: 0px;
			transform: translateY(-1.9px) scale(0.94);
		}
	}
	a {
		color: unset;
	}
	.contact-section a,
	.contact-section a:visited,
	.contact-section a:active {
		text-decoration: none;
		border-bottom: 1px solid transparent;
		padding-bottom: 1px;
		font-weight: 500;
		transition:
			border-bottom-color 0.25s ease,
			opacity 0.25s ease;
	}

	.contact-section .friend-link {
		color: var(--color-text-primary);
		border-bottom: none;
	}
	.contact-section .email-link {
		color: var(--color-text-main);
		border-bottom-color: var(--color-link-underline);
	}
	.contact-section .discord-link {
		color: var(--color-brand-discord);
		border-bottom-color: color-mix(in srgb, var(--color-brand-discord) 30%, transparent);
	}

	.contact-section a:hover,
	.contact-section a:focus {
		opacity: 0.85;
	}
	.contact-section .email-link:hover {
		border-bottom-color: var(--color-text-main);
	}
	.contact-section .discord-link:hover {
		border-bottom-color: var(--color-brand-discord);
	}
	.about-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 10px;
	}

	.intro-section {
		margin-top: 20px;
		line-height: 1.7;
		width: 100%;
		margin-bottom: 0px;
	}
	.intro-w-resume {
		display: flex;
		gap: 10px;
	}
	.resume-svg {
		width: 100%;
		height: 100%;
		display: block;
	}
	.resume-icon {
		padding-top: 1.7px;
		width: 24px;
		height: 24px;
	}

	.resume-icon:hover {
		transform: scale(1.1);
	}

	.intro-section p,
	.contact-section p {
		margin: 0 0 15px 0;
	}
	.contact-section p:last-child {
		margin-bottom: 0;
	}

	.socials-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 14px;
		margin-top: 12px;
		width: 100%;
	}

	.socials-label {
		color: var(--color-text-muted);
		white-space: nowrap;
		font-size: 0.9rem;
	}
</style>
