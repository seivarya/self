---
import Home from "../layouts/home.astro";
import Artbox from "../components/ui/artbox.astro";

// art imports
import devilman from "../content/arts/devilman_crybaby.png";
import titan from "../content/arts/attack_on_titan.png";
import ylia from "../content/arts/ylia.png";
import angel from "../content/arts/angel_of_death.png";

const images = [
	{
		title: "from devilman crybaby",
		link: devilman.src,
	},
	{
		title: "from attack on titan",
		link: titan.src,
	},
	{
		title: "from your lie in april",
		link: ylia.src,
	},
	{
		title: "from angels of death",
		link: angel.src,
	},
];
---

<Home>
	<h1>arts</h1>
	<p class="page-subtitle">
		things i've drawn / tried to draw over the years. it's not some "hobby" i just picked it on a whim so don't expect anything fancy. <br /><br />ps: this section is still incomplete i am refining my old drawings a bit for showcasing.
	</p>

	<div class="list-container">
		{images.map((art) => <Artbox title={art.title} link={art.link} />)}
	</div>
</Home>

<style>
	.list-container {
		display: flex;
		flex-direction: column;
		width: 100%;
		gap: 50px;
		padding-bottom: 75px;
	}
</style>
