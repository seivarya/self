---
const { pathname } = Astro.url;
---

<nav class="nav-bar">
	<div class="nav-row">
		<a href="/" class:list={[{ active: pathname === "/" }]}>home</a>
		<a href="/projects" class:list={[{ active: pathname.startsWith("/projects") }]} data-astro-prefetch="hover">projects</a>
		<a href="/notes" class:list={[{ active: pathname.startsWith("/notes") }]} data-astro-prefetch="hover">blogs</a>
	</div>
	<div class="nav-row">
		<a href="/misc" class:list={[{ active: pathname.startsWith("/misc") }]} data-astro-prefetch="hover">misc</a>
		<a href="/subscribe" class:list={[{ active: pathname.startsWith("/subscribe") }]} data-astro-prefetch="hover">subscribe</a>
	</div>
	<!-- for now i think i shouldn't keep arts section. -->
	<!-- <div class="nav-row">
		<a href="/arts" class:list={[{ active: pathname.startsWith("/arts") }]} data-astro-prefetch="hover">arts</a>
		</div> -->
</nav>

<style>
	nav.nav-bar {
		display: flex;
		flex-direction: column;
		justify-content: left;
	}
	nav {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: left;
		gap: 15px;
		width: fit-content;
	}

	.nav-row {
		display: flex;
		flex-direction: row;
		align-items: left;
		gap: 25px;
	}

	nav a,
	nav a:visited,
	nav a:active {
		display: inline-block;
		color: var(--color-text-muted);
		text-decoration: none;
		text-align: center;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 2px;
		transition:
			color 0.25s ease,
			border-bottom-color 0.25s ease;
	}

	nav a:hover,
	nav a:focus,
	nav a.active {
		color: var(--color-text-main);
		border-bottom-color: var(--color-text-main);
	}

	@media (max-width: 826px) {
		nav {
			margin-top: 0px;
		}

		.nav-row {
			justify-content: left;
		}
	}
</style>
