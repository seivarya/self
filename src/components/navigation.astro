---
const { pathname } = Astro.url;
---

<nav class="nav-bar">
	<div class="nav-row">
		<a href="/" class:list={[{ active: pathname === "/" }]}>home</a>
		<a href="/projects" class:list={[{ active: pathname.startsWith("/projects") }]} data-astro-prefetch="hover">projects</a>
		<a href="/notes" class:list={[{ active: pathname.startsWith("/notes") }]} data-astro-prefetch="hover">notes</a>
	</div>
	<div class="nav-row">
		<a href="/arts" class:list={[{ active: pathname.startsWith("/arts") }]} data-astro-prefetch="hover">arts</a>
	</div>
</nav>

<style>
	.nav-bar {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		width: fit-content;
	}

	.nav-row {
		display: flex;
		gap: 30px;
	}

	.nav-bar a,
	.nav-bar a:visited,
	.nav-bar a:active {
		display: inline-block;
		color: var(--color-text-muted);
		text-decoration: none;
		text-align: center;
		border-bottom: 1px solid var(--color-border);
		padding-bottom: 2px;
		transition:
			color 0.25s ease,
			border-bottom-color 0.25s ease;
	}

	.nav-bar a:hover,
	.nav-bar a:focus,
	.nav-bar a.active {
		color: var(--color-text-main);
		border-bottom-color: var(--color-text-main);
	}

	@media (max-width: 826px) {
		.nav-bar {
			margin-top: 10px;
		}

		.nav-row {
			justify-content: center;
		}
	}
</style>
