		<a href={twitter}>
			<div class="icon twitter-container">
				<svg xmlns="http://www.w3.org/2000/svg" xml:space="preserve" viewBox="0 0 248 204">
					<path fill="currentColor" d="M221.95 51.29c.15 2.17.15 4.34.15 6.53 0 66.73-50.8 143.69-143.69 143.69v-.04c-27.44.04-54.31-7.82-77.41-22.64 3.99.48 8 .72 12.02.73 22.74.02 44.83-7.61 62.72-21.66-21.61-.41-40.56-14.5-47.18-35.07 7.57 1.46 15.37 1.16 22.8-.87-23.56-4.76-40.51-25.46-40.51-49.5v-.64c7.02 3.91 14.88 6.08 22.92 6.32C11.58 63.31 4.74 33.79 18.14 10.71c25.64 31.55 63.47 50.73 104.08 52.76-4.07-17.54 1.49-35.92 14.61-48.25 20.34-19.12 52.33-18.14 71.45 2.19 11.31-2.23 22.15-6.38 32.07-12.26-3.77 11.69-11.66 21.62-22.2 27.93 10.01-1.18 19.79-3.86 29-7.95-6.78 10.16-15.32 19.01-25.2 26.16z"></path>
				</svg>
			</div>
		</a>

		<a href={telegram}>
			<div class="icon telegram-container">
				<svg viewBox="0 0 448 512">
					<path d="M446.7 98.6l-67.6 318.8c-5.1 22.5-18.4 28.1-37.3 17.5l-103-75.9-49.7 47.8c-5.5 5.5-10.1 10.1-20.7 10.1l7.4-104.9 190.9-172.5c8.3-7.4-1.8-11.5-12.9-4.1L117.8 284 16.2 252.2c-22.1-6.9-22.5-22.1 4.6-32.7L418.2 66.4c18.4-6.9 34.5 4.1 28.5 32.2z"></path>
				</svg>
			</div>
		</a>

		<a href={linkedin}>
			<div class="icon linkedin-container">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 21 21"
					aria-hidden="true"
					role="none"
					width="21"
					height="21"
					focusable="false"
				>
					<g>
						<path
							d="M19.5 0h-18A1.5 1.5 0 000 1.5v18A1.5 1.5 0 001.5 21h18a1.5 1.5 0 001.5-1.5v-18A1.5 1.5 0 0019.5 0zM6 18H3V8h3zM4.5 6.25A1.75 1.75 0 116.25 4.5 1.75 1.75 0 014.5 6.25zM18 18h-3v-5.09c0-1.62-.74-2.44-1.84-2.44A2.32 2.32 0 0011 12.91V18H8V8h3v1.39a4 4 0 013.3-1.63c1.77 0 3.66.93 3.66 4z"
							fill="currentColor"
						></path>
					</g>
				</svg>
			</div>
		</a>

		<a href={chess}>
			<div class="icon chess-container">
				<svg viewBox="0 0 50 50">
					<path
						fill="currentColor"
						stroke="currentColor"
						stroke-linejoin="round"
						d="M38.956.5c-3.53.418-6.452.902-9.286 2.984C5.534 1.786-.692 18.533.68 29.364 3.493 50.214 31.918 55.785 41.329 41.7c-7.444 7.696-19.276 8.752-28.323 3.084C3.959 39.116-.506 27.392 4.683 17.567 9.873 7.742 18.996 4.535 29.03 6.405c2.43-1.418 5.225-3.22 7.655-3.187l-1.694 4.86 12.752 21.37c-.439 5.654-5.459 6.112-5.459 6.112-.574-1.47-1.634-2.942-4.842-6.036-3.207-3.094-17.465-10.177-15.788-16.207-2.001 6.967 10.311 14.152 14.04 17.663 3.73 3.51 5.426 6.04 5.795 6.756.0.0 9.392-2.504 7.838-8.927L37.4 7.171z"
					></path>
				</svg>
			</div>
		</a>

		<a href={bluesky}>
			<div class="icon bluesky-container">
				<svg fill="none" viewBox="0 0 64 57">
					<path
						fill="currentColor"
						d="M13.873 3.805C21.21 9.332 29.103 20.537 32 26.55v15.882c0-.338-.13.044-.41.867-1.512 4.456-7.418 21.847-20.923 7.944-7.111-7.32-3.819-14.64 9.125-16.85-7.405 1.264-15.73-.825-18.014-9.015C1.12 23.022 0 8.51 0 6.55 0-3.268 8.579-.182 13.873 3.805ZM50.127 3.805C42.79 9.332 34.897 20.537 32 26.55v15.882c0-.338.13.044.41.867 1.512 4.456 7.418 21.847 20.923 7.944 7.111-7.32 3.819-14.64-9.125-16.85 7.405 1.264 15.73-.825 18.014-9.015C62.88 23.022 64 8.51 64 6.55c0-9.818-8.578-6.732-13.873-2.745Z"
					></path>
				</svg>
			</div>
		</a>
	</div>
</div>

<style>
	.main-container {
		display: contents;
	}

	a {
		color: unset;
		text-decoration: none;
	}

	.icons-container {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 16px;
	}

	.icon {
		display: flex;
		height: 24px;
		align-items: center;
		justify-content: center;
		color: var(--color-text-muted);
		cursor: pointer;
		transition:
			color 0.25s ease,
		transform 0.25s ease;
	}

	.icon svg {
		width: 19px;
		height: 19px;
		fill: currentColor;
	}

	.linkedin-container svg path {
		fill: currentColor;
	}

	.icon:hover {
		transform: scale(1.1);
	}

	.github-container {
		color: var(--color-brand-github);
	}
	.twitter-container {
		color: var(--color-brand-twitter);
	}
	.linkedin-container {
		color: var(--color-brand-linkedin);
	}
	.telegram-container {
		color: var(--color-brand-telegram);
	}
	.chess-container {
		color: var(--color-brand-chess);
	}
	.bluesky-container {
		color: var(--color-brand-bluesky);
	}

	@media (max-width: 768px) {
		.icon {
			height: 20px;
		}
		.icon svg {
			width: 16px;
			height: 16px;
		}
		.bluesky-container, .chess-container {
			display: none;
		}
	}
</style>
