---
const { title, link } = Astro.props;
---

<a class="img-container" href={link} target="_blank" rel="noopener noreferrer">
	<img class="img" src={link} alt={link} />

	<div class="img-footer">
		<p class="img-title">{title}</p>
	</div>
</a>

<style>
	a {
		color: unset;
	}

	.img-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		max-width: 800px;
		text-decoration: none;
	}

	.img {
		border: 1px solid var(--color-border);
		width: 100%;
		height: auto;
		max-width: 100%;

		transition:
			transform 0.25s ease,
		box-shadow 0.25s ease;
	}

	.img-container:hover .img {
		transform: scale(1.03);
		box-shadow: 0 8px 25px var(--color-border);
	}

	.img-footer {
		margin-top: 10px;
		display: flex;
		justify-content: center;
	}

	.img-title {
		font-size: 0.8rem;
	}


</style>
