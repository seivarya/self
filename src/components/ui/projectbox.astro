---
import GithubIcon from "../icons/github.astro";

interface Props {
title: string;
description: string;
tags: string[];
link?: string;
}

const { title, description, tags, link = "/" } = Astro.props;
---

<div class="project-box">
	<div class="header-row">
		<h3 class="title">{title}</h3>
		<a href={link} class="github-link" aria-label="GitHub Repository" target="_blank" rel="noopener noreferrer">
			<GithubIcon focusable="false" class="octicon octicon-mark-github" width="22" height="22" fill="currentColor" overflow="visible" style="vertical-align:text-bottom" />
		</a>
	</div>
	<p class="description">{description}</p>
	<div class="tags-container">
		{tags.map((tag) => <span class="tag">{tag}</span>)}
	</div>
</div>

<style>
	.project-box {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--color-border);
		padding: 22px;
		text-decoration: none;
		background-color: transparent;
		transition:
			border-color 0.2s ease,
		opacity 0.2s ease;
		cursor: default;
	}

	.project-box:hover {
		border-color: var(--color-text-muted);
		opacity: 0.9;
	}

	.project-box:hover .title,
	.project-box:hover .github-link {
		color: var(--color-text-main);
	}

	.project-box:hover .description {
		color: var(--color-text-primary);
	}

	.header-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
	}

	.github-link {
		color: var(--color-text-muted);
		transition:
			color 0.2s ease,
		transform 0.2s ease;
		cursor: pointer;
	}

	.github-link:hover {
		transform: scale(1.1);
	}

	.title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: bold;
		color: var(--color-text-primary);
		letter-spacing: 0.5px;
		transition: color 0.2s ease;
	}

	.description {
		margin: 22px 0;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text-muted);
		transition: color 0.2s ease;
	}

	.tags-container {
		display: flex;
		flex-wrap: wrap;
		gap: 15px;
		margin-top: auto;
	}

	.tag {
		background-color: var(--color-bg-alt);
		padding: 4px 8px;
		color: var(--color-text-primary);
		font-size: 0.9rem;
		transition: color 0.2s ease;
	}
</style>
