---

<div id="clock-container" transition:persist="clock">
	<span id="current-time">--:--:--</span>
	<span id="gmt">| GMT+5:30</span>
</div>

<style>
	#clock-container {
		display: flex;
		align-items: center;
		gap: 6px;
		color: var(--color-text-muted);
		font-family: inherit;
	}
</style>
<script is:inline>
	function clockTime() {
		var timeDisplay = document.getElementById("current-time");
		if (!timeDisplay) return;

		timeDisplay.textContent = new Date().toLocaleTimeString("en-GB", {
			timeZone: "Asia/Kolkata",
			hour: "2-digit",
			minute: "2-digit",
			second: "2-digit",
			hour12: false,
		});
	}
	clockTime();
	setInterval(clockTime, 1000);
</script>
