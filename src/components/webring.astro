---
import sites from "../content/data/webring.json";

interface site {
	name: string;
	url: string;
}
---

<div class="main-container">
	<div>
		<h4 class="webring-title">here's a webring of some cool people i know:</h4>
	</div>
	<div class="webring-container">
		{sites.map((site: site) => (
			<a class="webring-site" href={site.url}>{site.name}</a>
		))}
	</div>
</div>

<style>
	.main-container {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.webring-container {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2rem 1.5rem;
		align-items: center;
		justify-content: center;
	}

	.webring-title {
		display: inline-block;
		font-weight: 100;
		text-decoration: none;
	}

	.webring-site {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.35em 0.8em;
		font-family: inherit;
		font-weight: inherit;
		text-decoration: none;
		color: var(--color-text-muted);
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 0px;
		box-shadow: 0 3px 0 var(--color-text-italic);
		transition:
			transform 0.1s ease,
			box-shadow 0.1s ease,
			background 0.1s ease,
			color 0.1s ease;
		white-space: nowrap;
	}

	.webring-site:hover {
		color: var(--color-text-main);
		transform: translateY(3px);
		box-shadow: 0 0 0 var(--color-text-italic);
	}

	.webring-site:active {
		transform: translateY(3px);
		box-shadow: 0 0 0 var(--color-text-italic);
	}

	@media (max-width: 600px) {
		.main-container {
			gap: 1px;
		}
		.webring-title {
			font-size: 0.9rem;
		}
		.webring-container {
			justify-content: center;
			gap: 1rem 1rem;
		}
	}
</style>

