---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import { ClientRouter } from "astro:transitions";

import "../styles/global.css";
import "@fontsource/source-code-pro";
---

<!doctype html>
<html>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="index, follow" />
		<meta property="og:site_name" content="seivarya" />

		<meta property="og:title" content="seivarya" />
		<meta property="og:description" content="software engg." />

		<meta
			property="og:image"
			content="https://seivarya.in/self.jpg"
		/>
		<meta property="og:image:width" content="1000" />
		<meta property="og:image:height" content="1000" />

		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://seivarya.in" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="seivarya" />
		<meta name="twitter:description" content="softw. engg." />
		<meta
			name="twitter:image"
			content="https://seivarya.in/self.jpg"
		/>
		<meta name="theme-color" content="#ffeef1" />

		<title>seivarya</title>

		<link
			rel="icon"
			sizes="192x192"
			type="image/jpeg"
			href="/self.jpg"
		/>
		<link rel="apple-touch-icon" sizes="180x180" href="/self.jpg" />

		<script is:inline>
			function applyTheme() {
				const savedTheme =
					localStorage.getItem("theme") ||
					"light";
				document.documentElement.setAttribute(
					"data-theme",
					savedTheme,
				);
				if (savedTheme === "light") {
					document.querySelector(
						'meta[name="theme-color"]',
					)?.setAttribute("content", "#ffeef1");
				} else {
					document.querySelector(
						'meta[name="theme-color"]',
					)?.setAttribute("content", "#0f0e1a");
				}
			}
			applyTheme();
			document.addEventListener(
				"astro:after-swap",
				applyTheme,
			);
		</script>
	</head>

	<body>
		<div class="main-container">
			<Header />
			<slot />
			<Footer />
			<ClientRouter />
		</div>

		<script>
			// disable right click context menu, coz it looks cool
			document.addEventListener("contextmenu", (event) => {
				event.preventDefault();
			});
		</script>
	</body>

	<style>
		.main-container {
			box-sizing: border-box;
			display: flex;
			flex-direction: column;
			min-height: 100svh;
			width: 75vw;
			max-width: 750px;
			color: var(--color-text-primary);
			padding: 20px 10px;
			margin: 0 auto;
		}

		@media (max-width: 768px) {
			.main-container {
				width: 90vw;
				padding: 24px 0;
			}
		}
	</style>
</html>
