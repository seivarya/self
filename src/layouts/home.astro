---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import ThemeScript from "../components/theme.astro";
import { ClientRouter } from "astro:transitions";

import "../styles/global.css";
import "@fontsource/source-code-pro";
---

<!doctype html>
<html>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="index, follow" />
		<meta name="description" content="software engg." />
		<meta property="og:site_name" content="seivarya" />

		<meta property="og:title" content="seivarya" />
		<meta property="og:description" content="software engg." />

		<meta property="og:image" content="https://seivarya.in/rei.jpg" />
		<meta property="og:image:width" content="400" />
		<meta property="og:image:height" content="400" />

		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://seivarya.in" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="seivarya" />
		<meta name="twitter:description" content="softw. engg." />
		<meta name="twitter:image" content="https://seivarya.in/rei.jpg" />
		<meta name="theme-color" content="#0f0e1a" />

		<title>seivarya</title>

		<link
			rel="icon"
			sizes="192x192"
			type="image/jpeg"
			href="/rei.jpg"
		/>
		<link rel="apple-touch-icon" sizes="180x180" href="/rei.jpg" />
		<ThemeScript />
	</head>

	<body>
		<div class="main-container">
			<Header />
			<slot />
			<Footer />
			<ClientRouter />
		</div>
	</body><style>
		.main-container {
			box-sizing: border-box;
			display: flex;
			flex-direction: column;
			min-height: 100svh;
			width: 75vw;
			max-width: 750px;
			color: var(--color-text-primary);
			padding: 20px 10px;
			margin: 0 auto;
		}

		@media (max-width: 768px) {
			.main-container {
				width: 90vw;
				padding: 24px 0;
			}
		}
	</style>
</html>
